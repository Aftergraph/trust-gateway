{
  "contractVersion": "0.2",
  "id": "demo-echo",
  "name": "Demo Echo",
  "version": "1.0.0",
  "entry": "index.js",
  "description": "Minimal tracked module proving the install/enable/audit round-trip.",
  "capabilities": [
    "echo.speak"
  ],
  "permissions": [
    "read:*"
  ],
  "tools": [
    "echo.speak"
  ],
  "views": [
    "Card"
  ],
  "events": [
    "plugin.demo-echo.spoke"
  ],
  "automations": [],
  "sandbox": "jailed",
  "secrets": [
    {
      "name": "API_KEY",
      "required": false
    }
  ],
  "mcp": [
    {
      "name": "demo-echo-mcp",
      "transport": "stdio",
      "command": "node",
      "args": [
        "mcp/index.js"
      ]
    }
  ]
}
